################################################################################
# EXTERNAL API KEYS
################################################################################
# Get free API keys from:
# - Alpha Vantage: https://www.alphavantage.co/
# - MarketAux: https://www.marketaux.com/
# - NewsAPI: https://newsapi.org/
# - Finnhub: https://finnhub.io/

ALPHA_VANTAGE_API_KEY=demo
MARKETAUX_API_TOKEN=replace_me
FINNHUB_API_KEY=replace_me
NEWS_API_KEY=replace_me

################################################################################
# DATABASE CONFIGURATION
################################################################################
# Local Development: PostgreSQL running in Docker
DATABASE_URL=postgresql+asyncpg://investment_user:investment_pass@postgres:5432/investment_platform
DATABASE_ECHO=False

# Production (Railway): Auto-generated when PostgreSQL service is added
# Don't modify this - Railway sets it automatically

################################################################################
# REDIS CONFIGURATION
################################################################################
# Local Development: Redis running in Docker
REDIS_URL=redis://redis:6379/0

# Production (Railway): Auto-generated when Redis service is added
# Don't modify this - Railway sets it automatically

################################################################################
# MICROSERVICE URLS
################################################################################
# These are used by Gateway to route requests to other services
# In Docker Compose: use service names (gateway-service, etc.)
# In Railway: use internal service URLs (auto-configured)

MARKET_DATA_BASE_URL=http://market-data-service:8001
NEWS_SERVICE_BASE_URL=http://news-service:8002
ML_SIGNAL_BASE_URL=http://ml-signal-service:8003

REQUEST_TIMEOUT_SECONDS=20

################################################################################
# APPLICATION SETTINGS
################################################################################
# Local Development
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Production - Set these in Railway Variables panel, NOT in code
# ENVIRONMENT=production
# DEBUG=False
# LOG_LEVEL=INFO

################################################################################
# JWT / AUTHENTICATION SECURITY
################################################################################
# CRITICAL: Generate a strong secret key for production!
# Command: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Development: Use this test key
# Production: Generate unique key and set in Railway Variables

SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

################################################################################
# USER ALLOWLIST (Auto-approval Configuration)
################################################################################
# Comma-separated list of email addresses that are auto-approved on registration
# Users not in this list require manual admin approval before login access
#
# Security: This is the core protection for keeping your platform private
# Only add email addresses you trust
#
# Examples:
# - Single email: ALLOWLIST_EMAILS=admin@example.com
# - Multiple: ALLOWLIST_EMAILS=admin@example.com,user1@example.com,user2@example.com

ALLOWLIST_EMAILS=admin@example.com,user1@example.com,user2@example.com

################################################################################
# REACT FRONTEND (Client-Side Configuration)
################################################################################
# Frontend needs to know the API Gateway URL
# Local Development: http://localhost:8000
# Production: Set in Railway Variables to your gateway's public domain

# REACT_APP_BACKEND_URL=http://localhost:8000
# Production example: REACT_APP_BACKEND_URL=https://api-gateway.railway.app
