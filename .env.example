# External API Keys
ALPHA_VANTAGE_API_KEY=demo
MARKETAUX_API_TOKEN=replace_me
FINNHUB_API_KEY=replace_me
NEWS_API_KEY=replace_me

# Watchlist
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA

# Request Configuration
REQUEST_TIMEOUT_SECONDS=20

# Database Configuration
DATABASE_URL=postgresql+asyncpg://investment_user:investment_pass@postgres:5432/investment_platform
DATABASE_ECHO=False

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Service URLs
MARKET_DATA_BASE_URL=http://market-data-service:8001
NEWS_SERVICE_BASE_URL=http://news-service:8002
ML_SIGNAL_BASE_URL=http://ml-signal-service:8003

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# JWT Configuration (Phase 4)
SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
